<script>

// ===================================
// CÀI ĐẶT NGÀY KỶ NIỆM
// Ví dụ: "2026-31-10"
// ===================================

const START_DATE = "";

// Lời nhắn ngẫu nhiên

const messages = [
  "Hồng Ngân là một điều thật đáng yêu trong thế giới của Duy Hùng. ♡",
  "Mong chúng mình luôn biết trân trọng nhau.",
  "Mỗi ngày đều là một cơ hội để tạo thêm kỷ niệm đẹp.",
  "Cảm ơn vì đã xuất hiện trong cuộc sống của nhau. ♥",
  "Chúc cho câu chuyện của chúng mình luôn có thật nhiều niềm vui.",
  "Một chút yêu thương, dành riêng cho Hồng Ngân. ♡"
];

function newMessage() {
  const el = document.getElementById("message");
  el.style.opacity = 0;

  setTimeout(() => {
    const random = Math.floor(Math.random() * messages.length);
    el.textContent = messages[random];
    el.style.opacity = 1;
  }, 250);

  for(let i=0;i<5;i++){
    setTimeout(createHeart,i*130);
  }
}

// Bộ đếm thời gian

function updateCounter() {

  if(!START_DATE) return;

  const start = new Date(START_DATE + "T00:00:00");

  if(isNaN(start.getTime()) || start > new Date()) return;

  let diff = Math.floor((Date.now()-start.getTime())/1000);

  const d = Math.floor(diff/86400);
  diff %= 86400;

  const h = Math.floor(diff/3600);
  diff %= 3600;

  const m = Math.floor(diff/60);
  const s = diff%60;

  document.getElementById("days").textContent = d;
  document.getElementById("hours").textContent = String(h).padStart(2,"0");
  document.getElementById("minutes").textContent = String(m).padStart(2,"0");
  document.getElementById("seconds").textContent = String(s).padStart(2,"0");

  document.getElementById("counterNote").textContent =
    "Từng giây trôi qua, thêm một kỷ niệm được viết tiếp. ♡";
}

// Trái tim bay

function createHeart() {

  const heart = document.createElement("span");

  heart.className = "float-heart";
  heart.textContent = Math.random() > 0.5 ? "♡" : "♥";

  heart.style.left = Math.random()*100 + "vw";
  heart.style.fontSize = (13+Math.random()*18) + "px";
  heart.style.animationDuration = (5+Math.random()*4) + "s";

  document.body.appendChild(heart);

  setTimeout(() => heart.remove(),9500);
}

setInterval(updateCounter,1000);
updateCounter();

setInterval(() => {
  if(Math.random() > 0.4) createHeart();
},1400);

</script>

